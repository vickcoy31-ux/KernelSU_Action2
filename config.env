# ================================================================
# config.env -- GTA9 (SM-X110) · Android 14 · branch 14.0
# Format: xiaoleGun/KernelSU_Action (kernel_action)
# Varian: resukisu · NEED_DTBO=true
# ================================================================

CONFIG_ENV=config.env

KERNEL_SOURCE=https://github.com/vickcoy31-ux/kernelvalidevo
KERNEL_SOURCE_BRANCH=14.0
KERNEL_CONFIG=gta9_00_defconfig
KERNEL_IMAGE_NAME=Image.gz
ARCH=arm64
KERNEL_NAME=
ADD_LOCALVERSION_TO_FILENAME=false
EXTRA_CMDS=-k
# KCFLAGS is space-separated and is exported as its own variable. It must NOT
# be folded into EXTRA_CMDS: that string is expanded unquoted so it word-splits
# into make arguments, which tears a multi-flag value apart. The old
# comma-joined form was rejected outright by clang ("unknown -Werror warning
# specifier"), so DISABLE_CC_WERROR had not been in effect since run #43.
KCFLAGS=-Wno-error -Wno-error=deprecated-non-prototype -Wno-error=unused-but-set-variable -Wno-error=unused-function -Wno-error=implicit-int -Wno-error=frame-larger-than -Wno-error=comment -Wno-error=implicit-function-declaration -Wno-error=incompatible-pointer-types -Wno-error=unused-result -Wno-error=declaration-after-statement
CUSTOM_CMDS=

CLANG_BRANCH=main-kernel-2025
CLANG_VERSION=r547379
USE_CUSTOM_CLANG=true
CUSTOM_CLANG_SOURCE=https://github.com/ZyCromerZ/Clang/releases/download/16.0.6-20260807-release/Clang-16.0.6-20260807.tar.gz
CUSTOM_CLANG_BRANCH=
USE_LLVM=true

ENABLE_GCC_ARM64=false
ENABLE_GCC_ARM32=false
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

KSU_VARIANT=resukisu
KSU_REF=
KSU_HOOK_MODE=tracepoint
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

ENABLE_SUSFS=false
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

ENABLE_PATH_UMOUNT=false
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=false
DISABLE_LTO=false
DISABLE_CC_WERROR=true
# Diagnostic (run #75/#76 only). It has done its job: it proved that DECLARE_TRACE
# is already a no-op after define_trace.h, and it produced a phantom 20-undefined
# error in #76 when its own -imacros path was wrong. Off from here.
REGULATOR_TRACE_PROBE=false
EXTRA_DEFCONFIG=CONFIG_DEBUG_FS=y CONFIG_DEBUG_FS_ALLOW_ALL=y CONFIG_CPU_FREQ=y CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y CONFIG_CPU_FREQ_STAT=y CONFIG_CPU_FREQ_TIMES=y CONFIG_CPU_FREQ_THERMAL=y CONFIG_CPU_FREQ_GOV_COMMON=y CONFIG_CPU_FREQ_GOV_PERFORMANCE=y CONFIG_CPU_FREQ_GOV_POWERSAVE=y CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y CONFIG_CPU_IDLE=y CONFIG_CPU_IDLE_MULTIPLE_DRIVERS=y CONFIG_MTK_AEE_IPANIC=n CONFIG_MTK_MKP=n CONFIG_MTK_PERF_COMMON=n CONFIG_MTK_PERF_TRACKER=n CONFIG_MTK_SCHEDULER=n CONFIG_MTK_TASK_TURBO=n CONFIG_MTK_VOW_SUPPORT=n CONFIG_MTK_AEE_FEATURE=n CONFIG_MTK_ECCCI_DRIVER=n CONFIG_MTK_COMBO=n CONFIG_NET=y CONFIG_INET=y CONFIG_SECURITY=y CONFIG_AUDIT=y CONFIG_SECURITY_NETWORK=y CONFIG_SECURITY_SELINUX=y CONFIG_MTK_CAMERA_ISP_RAW_SUPPORT=n CONFIG_MTK_TINYSYS_VCP_SUPPORT=n CONFIG_MTK_TINYSYS_SCP_SUPPORT=y CONFIG_MTK_USB_BOOST=n CONFIG_BATTERY_MT6359P=n CONFIG_GAUGE_MT6375=n CONFIG_MTK_IOMMU_MISC_DBG=m CONFIG_MTK_IOMMU_MISC_TEST=n CONFIG_MTK_IOMMU_MISC_SECURE=n CONFIG_IIO=y CONFIG_REGULATOR=y CONFIG_GXY_PSY_SYSFS=y CONFIG_TCPC_AW35615=y CONFIG_SEC_DEBUG=y CONFIG_SEC_REBOOT=n CONFIG_USB_SUPPORT=y CONFIG_USB=y CONFIG_USB_OTG=y CONFIG_USB_GADGET=y CONFIG_DMABUF_HEAPS=y CONFIG_DMABUF_HEAPS_DEFERRED_FREE=y CONFIG_DMABUF_HEAPS_PAGE_POOL=y CONFIG_MTK_TRUSTED_MEMORY_SUBSYSTEM=y CONFIG_REMOTEPROC=y CONFIG_NVMEM=y CONFIG_BATTERY_ID_ADC=y CONFIG_MTK_DEVINFO=y CONFIG_MTK_HANG_DETECT=y CONFIG_RTC_CLASS=y CONFIG_RTC_LIB=y CONFIG_ODM_BOARD_ID_STATUS_SUPPORT=y CONFIG_MAILBOX=y CONFIG_RPMSG_MTK_CCD=y CONFIG_FTRACE=y CONFIG_ENABLE_DEFAULT_TRACERS=y CONFIG_MEDIA_SUPPORT=y CONFIG_MEDIA_PLATFORM_SUPPORT=y CONFIG_MEDIA_CONTROLLER=y CONFIG_VIDEO_DEV=y CONFIG_VIDEO_V4L2=y CONFIG_VIDEO_V4L2_SUBDEV_API=y CONFIG_MEDIA_CONTROLLER_REQUEST_API=y CONFIG_VIDEOBUF2_VMALLOC=y CONFIG_VIDEOBUF2_DMA_CONTIG=y CONFIG_ANDROID=y CONFIG_MTK_PMIC_PROTECT=n CONFIG_MTK_CONN_SCP=n CONFIG_ANDROID_VENDOR_HOOKS=y CONFIG_SYNC_FILE=y CONFIG_PM_WAKELOCKS=y CONFIG_ARM_SCMI_PROTOCOL=y CONFIG_DRM=y CONFIG_DRM_MEDIATEK=y CONFIG_BOOT_CONFIG=y
# --- run #82: the last 6 undefined symbols, all now traced -------------------
# Run #81 gave the first fully clean link in every category at once: 0 compile
# errors, 0 duplicate symbols, 6 undefined. Nothing is hidden under anything
# else, so this list is complete and this is the last batch.
#
# 4 of the 6 are one root cause. drivers/gpu/drm/mediatek/Kconfig:
#     config DRM_MEDIATEK
#         tristate "DRM Support for Mediatek SoCs"
#         depends on DRM
#     and CONFIG_DRM is a menuconfig tristate with no default, in a 7938-line
#     defconfig that the 532-line gta9_00_defconfig was copied from. One missing
#     line nulled the whole display-driver family. The trap is that
#     CONFIG_DRM_MEDIATEK_V2=y IS present and looks like "display is on" -- but
#     it is a standalone bool in mediatek_v2/Kconfig with no depends on
#     DRM_MEDIATEK at all, so it gates nothing and is pure noise. The real
#     provider is obj-$(CONFIG_DRM_MEDIATEK) += mediatek-drm.o, and
#     mtk_disp_notify.o, mtk_dp.o (which holds both mtk_dp_* symbols) and all
#     ~55 objects in mediatek-drm-y hang off it.
#     CONFIG_DRM, CONFIG_DRM_MEDIATEK, CONFIG_DRM_FBDEV_EMULATION and
#     CONFIG_DRM_TTM are all =y in the vendor defconfig.
#
#   This is the largest single change in the whole project, and it is not
#   optional: without mediatek-drm there is no display driver at all, so the
#   tablet would boot to a black screen. It is deferred to this run only because
#   a compile error in a 55-object subsystem would have masked the other fixes.
#   All of its depends are already satisfied -- DRM's own (ARCH_MEDIATEK, OF,
#   COMMON_CLK, HAVE_ARM_SMCCC, MTK_MMSYS) are all y in the #81 .config.
#
# --- run #86: the last five, all one root cause: a config that was never there -
# Run #85 compiled the whole tree and linked it with exactly ONE undefined
# symbol left, and -- this is the part worth recording -- five implicit-function
# declaration warnings that -Wno-error=implicit-function-declaration in KCFLAGS
# had been hiding. All five come from the same gap: the defconfig copy predates
# the subsystems those files were written against.
#
#   mtk_debug.c:299          mrdump_mini_add_extra_file
#   mtk_cm_mgr_common.c:1004 cpufreq_frequency_table_target
#   mtk_pbm.c:973            cpufreq_table_count_valid_entries
#   teeperf/user.c:32        cpufreq_table_find_index_dl
#   teeperf/user.c:45        cpufreq_update_limits
#
# CONFIG_CPU_FREQ is not set in the run-#85 .config, yet cm_mgr, pbm and teeperf
# all call cpufreq APIs. All four are static inline in include/linux/cpufreq.h
# and three of them sit under #ifdef CONFIG_CPU_FREQ, so with the parent off they
# are not compiled at all -- no declaration, and, being static inline, no symbol
# to fall back on either. The one real function, cpufreq_update_limits, is a
# plain declaration, so it would have become a second undefined symbol the
# moment the first was fixed. Enabling the subsystem fixes all four at once.
# The vendor ships CONFIG_CPU_FREQ=y with GOV_SCHEDUTIL, STAT, TIMES, THERMAL,
# GOV_COMMON and the performance/powersave/conservative governors, so all of
# those are listed here. Same reasoning for CONFIG_CPU_IDLE, which the vendor
# also ships y, and which the cpufreq core pulls in.
#
# CONFIG_DEBUG_FS=y -- the root of the other one. mtk_debug.c:11-14 includes
# <mt-plat/mrdump.h> only inside #if IS_ENABLED(CONFIG_DEBUG_FS), and DEBUG_FS is
# "not set" in the #85 .config, so the header was never read. Inside it,
# mrdump_mini_add_extra_file is a static inline no-op returning -1 unless
# CONFIG_MTK_AEE_IPANIC is set, and the real implementation lives in
# aee/mrdump/mrdump_mini.c which is gated by obj-$(CONFIG_MTK_AEE_IPANIC).
# So with DEBUG_FS off the call is not merely undeclared, it is not a symbol at
# all. The vendor ships DEBUG_FS=y with DEBUG_FS_ALLOW_ALL=y.
#
# CONFIG_MTK_AEE_IPANIC=n is stated explicitly, and deliberately. AEE_IPANIC is
# absent from the #85 .config already, and IS_ENABLED() of an undefined symbol is
# 0, so the header's no-op branch would be taken and this would be harmless.
# But CONFIG_MTK_AEE_FEATURE=n is one of our own pins and aee/Makefile gates
# mrdump/ on that, not on IPANIC. Making the dependency explicit here means the
# stub path does not depend on a symbol merely being absent -- if a later change
# ever brings AEE_IPANIC in without its provider, the .config will say n rather
# than leaving it to inference.
#
# Not changed: CONFIG_CPU_FREQ_BOOST. It is absent from the vendor defconfig too,
# so there is nothing to restore.
#
# After this the link has no outstanding errors of any class.
#
# CONFIG_BOOT_CONFIG=y -- xbc_node_find_value, called by
# security/samsung/defex_lsm/core/defex_lsm.c:143 via xbc_find_value(), which is
# itself a one-line wrapper: return xbc_node_find_value(NULL, key, vnode).
# Both live in lib/bootconfig.c, and lib/Makefile:278 is
#     obj-$(CONFIG_BOOT_CONFIG) += bootconfig.o
# so the whole file is skipped. init/Kconfig:1388 declares it as a plain visible
# bool "Boot config support" with no default, dropped by truncation. Vendor
# ships it y. One object. Note the other six ld.lld errors are gone, so
# CONFIG_SECURITY_DEFEX=y is already building defex_lsm.o and this is the only
# thing it is missing.
#
# CORRECTION from run #82: I also had CONFIG_DRM_FBDEV_EMULATION=y and
# CONFIG_DRM_TTM=y here. Both are wrong and both are removed.
#   - DRM_FBDEV_EMULATION is what drags mtk_drm_fbdev.o into mediatek-drm-y
#     (Makefile:77), and that file does not compile in this tree at all. See
#     build.sh patch 23.
#   - DRM_TTM is a tristate with no prompt whose only depends is DRM && MMU.
#     The vendor defconfig does carry CONFIG_DRM_TTM=y, but it is a no-op for
#     mediatek-drm, which does not select it, so it resolved to nothing and just
#     added a line to guess at. I read the vendor column wrong when I added it.
#
# task_is_booster is NOT in this run. block/elevator.c:767 forward-declares it
# and :774 calls it, but a full search of kernel/sched/ (all 35 files) and all 19
# files under drivers/misc/mediatek/sched/ finds no definition and not one other
# mention of the word "booster" in either tree. The provider is not switched off
# by a config -- it is absent from this kernel. The honest fix is a build.sh
# patch, and it needs its own run so its effect can be read on its own.

# --- run #88: DTBO ------------------------------------------------------------
# Run #87 produced a kernel image for the first time in 87 runs:
#     GZIP    arch/arm64/boot/Image.gz
#     SYSMAP  System.map
#     [*] kernel image: Image.gz (8.0M)
#     0 compile errors, 0 duplicate symbols, 0 undefined symbols
# and then failed in the verification step, not the build:
#     [x] NEED_DTBO=true but .../out/arch/arm64/boot/dtbo.img was not produced
#
# No dtbo.img can be produced, and not because anything is misconfigured.
# arch/arm64/boot/dts/mediatek/Makefile builds overlays from a config-provided
# list:
#     ifeq ($(strip $(CONFIG_BUILD_ARM64_DTB_OVERLAY_IMAGE)), y)
#     dtbo-y += $(addsuffix .dtbo, $(notdir $(subst $",,$(CONFIG_BUILD_ARM64_DTB_OVERLAY_IMAGE_NAMES))))
#     endif
# and in the run-#87 .config both halves are inert:
#     CONFIG_BUILD_ARM64_DTB_OVERLAY_IMAGE=y
#     CONFIG_BUILD_ARM64_DTB_OVERLAY_IMAGE_NAMES=""
# The names list is empty, so dtbo-y expands to nothing. The two dtb-y lines
# above it are commented out in the source as well:
#     #dtb-y += mt6789.dtb
#     #dtb-y += mt8781_gta9_eur_open_00.dtb
# The vendor defconfig carries no BUILD_ARM64_DTB_* line at all -- these are
# set by build.py in the vendor's platform build, from per-project values that
# are not in this repository. There is no .dtbo source in the tree either:
# arch/arm64/boot/dts/mediatek/ has DTS sources for the SoC but no overlay
# source, and no binary .dtbo is committed anywhere.
#
# So NEED_DTBO=true asks for an artefact that this kernel source cannot produce.
# It is set false here. This is the second time in this file that a flag has
# been set based on a platform-build convention rather than on anything in the
# tree, and the same reasoning applies: the flag was inherited from an xiaoleGun
# config where the vendor blob supplied the overlay.
#
# What this costs: on a device that genuinely needs a DTBO overlay flashed
# alongside the kernel, the tablet would boot without it. For SM-X110 the
# kernel is flashed together with the stock DTB, so NEED_DTBO=false is the
# expected setting for a device in this configuration. If the tablet comes up to
# a black screen, this is the first thing to re-examine, along with whether
# CONFIG_MTK_DTBO_FEATURE=y (which IS set) is expected to pull in an overlay
# source that is not in the tree.
#
# --- run #78: the 20 undefined symbols that run #77 finally exposed ------------
# lld stops at the first "duplicate symbol" error, so everything underneath it
# stayed hidden until patch 16 step 1 cleared the duplicates. These are the
# symbols that were already missing before, not new breakage. Each block below
# is listed in the order the symbols appear in the EXTRA_DEFCONFIG line above.
#
# 11 video symbols (video_device_alloc, v4l2_ctrl_*, v4l2_async_*,
# media_entity_pads_init, v4l2_fwnode_endpoint_parse): gta9_00_defconfig is a
# truncated copy of the vendor one and never carried the media core. The values
# used are copied from the vendor gta9_defconfig, which ships them as y.
# CONFIG_VIDEO itself is a promptless bool in this tree, so it never appears in
# .config; CONFIG_VIDEO_DEV is the line that actually pulls in the v4l2 core.
#
# 3 android_vh hooks (register_trace_android_vh_show_mem / _logbuf /
# _meminfo_proc_show): CONFIG_ANDROID was off, so CONFIG_ANDROID_VENDOR_HOOKS
# could never be satisfied. TRACEPOINTS is already on above, so setting the
# parent is enough -- same =y as the vendor defconfig.
#
# 1 symbol, and the provider here is a pin of ours. exec_ccci_kern_func_by_md_id
# is declared in include/mt-plat/mtk_ccci_common.h and defined inside the eccci
# tree, which is gated on CONFIG_MTK_ECCCI_DRIVER -- pinned =n back in run #48
# because that tree could not find scp_ipi.h. mt63xx-oc-debug.c calls it with no
# #ifdef around the call, so it is referenced unconditionally. Re-opening the
# ECCCI pin would undo #48; the consumer cannot work without the provider
# anyway, so the consumer is what goes.
#
# 1 symbol, same shape. connectivity_register_state_notifier is defined in
# connectivity/common/connectivity_build_in_adapter.o, built by
# obj-$(CONFIG_MTK_COMBO) in drivers/misc/mediatek/connectivity/Makefile --
# and MTK_COMBO is one of our own =n pins. The consumer is
# conn_scp/conap_scp/conap_scp_core.c (obj-$(CONFIG_MTK_CONN_SCP)), which calls
# it unguarded at conap_scp_init(). With no adapter on the other side the notifier
# has nothing to attach to, so the consumer goes rather than the pin.
#
# The remaining 4 of the 20 (n3d_init, n3d_exit, set_sensor_streaming_state,
# register_3way_semaphore_notifier, unregister_3way_semaphore_notifier) are not
# config at all -- they are dead Makefile rules, fixed in scripts/build.sh as
# the revised patch 5 and the new patch 17.

USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

NEED_DTBO=false
# --- run #90: the target flashes with Odin, so produce a boot.img -------------
# The AnyKernel3 zip is not the artefact for Odin. Odin writes a partition
# image, and on this device the kernel lives in BOOT, so what is needed is a
# repacked boot.img carrying the new kernel.
#
# The stock boot image is already committed in this repository at boot/boot.img
# (18,874,368 bytes, ANDROID! magic), so SOURCE_BOOT_IMAGE points at it and
# package.sh copies it rather than fetching it.
#
# IMPORTANT, and worth more than the convenience: that committed image has to
# match the firmware currently on the tablet. Repacking a boot image from a
# different firmware onto this one is how a device ends up in a boot loop. If
# the tablet is on a different firmware build than the one boot/boot.img came
# from, extract this tablet's own stock boot image and point SOURCE_BOOT_IMAGE at
# that instead. The build does not care where the file comes from, only that it
# is a valid boot image of the right device.
#
# The artifact name will be boot<localversion>-ReSukiSU_main-fa8311f6-gta9_00-*,
# and the workflow already has an upload step for it, guarded on
# MAKE_BOOT_IMAGE_IS_OK, which make_boot_image exports.
#
# The AnyKernel3 zip is still built in the same run, so both flashing methods
# are covered and nothing is lost either way.
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=boot/boot.img

# --- Odin: repack the stock boot image with this build's kernel ----------------
# BUILD_BOOT_IMG above stays false on purpose. That path uses the mkbootimg
# python tools against boot/boot.img, which is committed in this repository and
# is a different device: 18,874,368 bytes, kernel 4.19.271-Miku, built for
# androidboot.hardware=qcom. This tablet is MediaTek MT6789 on 5.10.205, so
# repacking that image would produce something structurally valid and
# completely wrong. The path below downloads the image this device actually
# ships with instead, and checksums it.
#
# The tablet is Samsung SM-X110, firmware X110XXS4BYBF (UP1A.231005.007, OS 14),
# build UP1A.231005.007.X110XXS4BYBF. Its stock boot image lives in the
# RESUKIASU repository and is byte-identical to the boot.img.lz4 extracted from
# the full AP firmware:
#     sha256 B361173E96EE8E85D647FDC152DA1DCA82FCCFFC3ACDF614D319EAAF458F3744
# That hash is the reason this is safe to fetch over the network. Both files
# are called boot.img and both are valid boot images, so a wrong one is
# undetectable by inspection -- but a boot image from different firmware is how
# a tablet ends up in a boot loop. The checksum turns that into a build error
# instead of a brick. If the tablet is ever updated to other firmware, change
# both values together or the build will refuse rather than guess.
BUILD_ODIN_BOOT_IMG=true
ODIN_BOOT_SOURCE_URL=https://raw.githubusercontent.com/vickcoy31-ux/RESUKIASU/main/boot.img.lz4
ODIN_BOOT_SOURCE_SHA256=B361173E96EE8E85D647FDC152DA1DCA82FCCFFC3ACDF614D319EAAF458F3744
# magiskboot is not published as a Linux binary by the community builds
# (macOS, Windows, wasm and source only), so it is taken from the Magisk APK,
# which ships it per ABI. Pinned to a release tag rather than latest so the
# tool doing the repack is the same one on every rebuild.
MAGISK_APK_URL=https://github.com/topjohnwu/Magisk/releases/download/v30.7/app-debug.apk

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
