# The same modular profile as config/gta9_android12.env, with one difference that
# decides whether the tablet can use this kernel at all.
#
# Run #111 built clean: 0 compile errors, 0 undefined, 0 duplicate, 0 modpost
# errors, and produced a valid 67,108,864-byte boot image whose ramdisk is
# byte-identical to stock with only the kernel replaced. It is still not
# flashable, and the reason is the release string:
#
#     stock   5.10.205-android12-9-28698995
#     built   5.10.205-gta9-ga5002f750537
#
# The tablet is modular. It loads its drivers from /vendor_dlkm, and those .ko
# files are the ones Samsung built, carrying the vermagic that build produced.
# insmod compares it and refuses:
#
#     insmod: version magic '5.10.205-android12-9-28698995' should be
#             '5.10.205-gta9-ga5002f750537'
#
# Nothing signs the modules -- "# CONFIG_MODULE_SIG is not set" in the stock
# config, and the same in ours -- so the string is the only thing in the way.
# KERNEL_LOCALVERSION makes the kernel report exactly what the tablet already
# expects, and the drivers load.
#
# This is the only difference from gta9_android12.env. Everything else is
# copied, not rewritten, so the two profiles cannot drift on anything that is
# not what this one is testing.

KERNEL_SOURCE=https://github.com/vickcoy31-ux/kernelvalidevo
KERNEL_SOURCE_BRANCH=14.0
KERNEL_CONFIG=/config/gta9_stock_defconfig
KERNEL_NAME=gta9

# The tablet's own `uname -a`, taken from the stock kernel this device shipped
# with. KERNEL_NAME above still labels the artifacts; this is what the kernel
# will call itself, and it is the part that has to match.
KERNEL_LOCALVERSION=-android12-9-28698995

KSU_VARIANT=resukisu
KSU_HOOK_MODE=tracepoint
ENABLE_SUSFS=false
ENABLE_PATH_UMOUNT=false
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

USE_CUSTOM_CLANG=true
CUSTOM_CLANG_SOURCE=https://github.com/ZyCromerZ/Clang/releases/download/16.0.6-20260807-release/Clang-16.0.6-20260807.tar.gz
USE_LLVM=true
ENABLE_GCC_ARM64=false
ENABLE_GCC_ARM32=false

DISABLE_CC_WERROR=true
DISABLE_LTO=false
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=false
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
NEED_DTBO=false
KERNEL_IMAGE_NAME=Image.gz
KCFLAGS=-Wno-error -Wno-error=deprecated-non-prototype -Wno-error=unused-but-set-variable -Wno-error=unused-function -Wno-error=implicit-int -Wno-error=frame-larger-than -Wno-error=comment -Wno-error=implicit-function-declaration -Wno-error=incompatible-pointer-types -Wno-error=unused-result -Wno-error=declaration-after-statement

# The AnyKernel3 zip is not what Odin writes; Odin needs a boot image. BUILD_BOOT_IMG
# stays false because that path uses mkbootimg, which is not what the tablet's
# stock image is -- this one repacks the real firmware image instead, and the
# sha256 below is what pins it. The hash is the tablet's own boot.img.lz4, so
# a wrong device or a wrong firmware fails here rather than as a boot loop.
BUILD_BOOT_IMG=false
BUILD_ODIN_BOOT_IMG=true
ODIN_BOOT_SOURCE_URL=https://raw.githubusercontent.com/vickcoy31-ux/RESUKIASU/main/boot.img.lz4
ODIN_BOOT_SOURCE_SHA256=B361173E96EE8E85D647FDC152DA1DCA82FCCFFC3ACDF614D319EAAF458F3744
MAGISK_APK_URL=https://github.com/topjohnwu/Magisk/releases/download/v30.7/app-debug.apk
SOURCE_BOOT_IMAGE=boot/boot.img
USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=
EXTRA_CMDS=
CUSTOM_CMDS=

# The whitelist path points at /home/dpi/qb5_8814/... and has never been
# published, so symbol pruning cannot run here. The stock config has
# CONFIG_TRIM_UNUSED_KSYMS=y; leaving it off only means this kernel exports more
# symbols than the tablet's modules need, which modules never object to.
#
# The twenty-four MT6983 options name a different chipset and do not compile
# against this branch's sound driver and clock tree. CONFIG_MTK_COMBO is the
# WiFi and Bluetooth combo chip and is deliberately untouched: a kernel without
# it is a tablet that cannot connect to anything.
EXTRA_DEFCONFIG=CONFIG_TRIM_UNUSED_KSYMS=n CONFIG_SND_SOC_MT6983=n CONFIG_SND_SOC_MT6983_MT6338=n CONFIG_COMMON_CLK_MT6983=n CONFIG_COMMON_CLK_MT6983_ADSP=n CONFIG_COMMON_CLK_MT6983_CAM=n CONFIG_COMMON_CLK_MT6983_CCU=n CONFIG_COMMON_CLK_MT6983_IMG=n CONFIG_COMMON_CLK_MT6983_MMSYS=n CONFIG_COMMON_CLK_MT6983_IMP_IIC_WRAP=n CONFIG_COMMON_CLK_MT6983_MDPSYS=n CONFIG_COMMON_CLK_MT6983_MFG=n CONFIG_COMMON_CLK_MT6983_VCODEC=n CONFIG_DEVAPC_MT6983=n CONFIG_MTK_SLBC_MT6983=n CONFIG_MTK_CM_MGR_MT6983=n CONFIG_MTK_DCM_MT6983=n CONFIG_MTK_LPM_MT6983=n CONFIG_MTK_SWPM_MT6983=n CONFIG_MTK_MDP_MT6983=n CONFIG_TOUCHSCREEN_MT6983_ALPHA_SUPPORT=n CONFIG_PINCTRL_MT6983=n CONFIG_GAUGE_MT6983_ALPHA_SUPPORT=n CONFIG_REGULATOR_MT6983_ALPHA_SUPPORT=n CONFIG_MTK_GPU_MT6983_SUPPORT=n
