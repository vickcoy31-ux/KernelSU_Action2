# gta9_00_defconfig — 478 options, compiled, booted to nothing.
#
# CONFIG_ARM_GIC, CONFIG_ARM_GIC_V3, ten COMMON_CLK drivers,
# CONFIG_OF_RESERVED_MEM, CONFIG_INTERCONNECT, the MTK_APUSYS engines and
# every CONFIG_DRM_LCD_* panel are all absent from the 478, which is why the
# 20 MB kernel it produced restarted instead of reaching userspace. There is
# no configuration in this tree that both has the drivers and belongs to
# branch 14.0, so the base is the device's own config, extracted from its
# stock boot.img:
#
#     IKCFG_ST at offset 0x1834220, 217,350 bytes, 6,431 options
#
# That config is modular, and the previous attempt to make it monolithic
# (CONFIG_MODULES=n) was wrong: the transpose turned all 191 per-SoC
# options into y, and the link failed on duplicate symbols that appeared in a
# different set each round -- CM_MGR, then the codec clocks, then the swcgs
# tables. That set has no visible end, because which of them collide is the
# linker's decision rather than anything the config states.
#
# So modules stay modules. The cost is the undefined-symbol list: consumers
# inside vmlinux cannot see providers that live in .ko files. The fix for
# each of those is to make the provider built-in, which is ordinary and
# finite, and is what this profile does. Nothing here is per-SoC except the
# MT6983 options, which name a different chipset and do not compile against
# this branch's sound driver and clock tree.
#
# What is NOT here, deliberately:
#   CONFIG_MODULES — kept on. See above.
#   The 19 CONFIG_*=m options that were pinned to n for the monolithic
#   attempt (AEE, MKP, USB_BOOST, DEBUG_KINFO, LEDS_MTK_PWM, CPUQOS_V3,
#   CM_MGR per-SoC, COMMON_CLK per-SoC). With modules on they compile, and
#   the first six no longer need to be off for struct module's sake.
#   CONFIG_MTK_COMBO — the WiFi and Bluetooth combo chip. A tablet that
#   builds without it is a tablet that cannot connect to anything.
#
# Set SOC=6789 in the workflow; this file is device-specific and will refuse
# to run against any other tree rather than guess.

KERNEL_SOURCE=https://github.com/vickcoy31-ux/kernelvalidevo
KERNEL_SOURCE_BRANCH=14.0
KERNEL_CONFIG=/config/gta9_stock_defconfig
KERNEL_NAME=gta9

KSU_VARIANT=resukisu
KSU_HOOK_MODE=tracepoint
ENABLE_SUSFS=false
ENABLE_PATH_UMOUNT=false
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

USE_CUSTOM_CLANG=true
KERNEL_IMAGE_NAME=Image.gz
KCFLAGS=-Wno-error -Wno-error=deprecated-non-prototype -Wno-error=unused-but-set-variable -Wno-error=unused-function -Wno-error=implicit-int -Wno-error=frame-larger-than -Wno-error=comment -Wno-error=implicit-function-declaration -Wno-error=incompatible-pointer-types -Wno-error=unused-result -Wno-error=declaration-after-statement
CUSTOM_CLANG_SOURCE=https://github.com/ZyCromerZ/Clang/releases/download/16.0.6-20260807-release/Clang-16.0.6-20260807.tar.gz
USE_LLVM=true
ENABLE_GCC_ARM64=false
ENABLE_GCC_ARM32=false

DISABLE_CC_WERROR=true
DISABLE_LTO=false
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=false
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=boot/boot.img
USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=
EXTRA_CMDS=
CUSTOM_CMDS=

# The whitelist path points at /home/dpi/qb5_8814/... and has never been
# published, so symbol pruning cannot run here.
EXTRA_DEFCONFIG=CONFIG_TRIM_UNUSED_KSYMS=n CONFIG_SND_SOC_MT6983=n CONFIG_SND_SOC_MT6983_MT6338=n CONFIG_COMMON_CLK_MT6983=n CONFIG_COMMON_CLK_MT6983_ADSP=n CONFIG_COMMON_CLK_MT6983_CAM=n CONFIG_COMMON_CLK_MT6983_CCU=n CONFIG_COMMON_CLK_MT6983_IMG=n CONFIG_COMMON_CLK_MT6983_MMSYS=n CONFIG_COMMON_CLK_MT6983_IMP_IIC_WRAP=n CONFIG_COMMON_CLK_MT6983_MDPSYS=n CONFIG_COMMON_CLK_MT6983_MFG=n CONFIG_COMMON_CLK_MT6983_VCODEC=n CONFIG_DEVAPC_MT6983=n CONFIG_MTK_SLBC_MT6983=n CONFIG_MTK_CM_MGR_MT6983=n CONFIG_MTK_DCM_MT6983=n CONFIG_MTK_LPM_MT6983=n CONFIG_MTK_SWPM_MT6983=n CONFIG_MTK_MDP_MT6983=n CONFIG_TOUCHSCREEN_MT6983_ALPHA_SUPPORT=n CONFIG_PINCTRL_MT6983=n CONFIG_GAUGE_MT6983_ALPHA_SUPPORT=n CONFIG_REGULATOR_MT6983_ALPHA_SUPPORT=n CONFIG_MTK_GPU_MT6983_SUPPORT=n
