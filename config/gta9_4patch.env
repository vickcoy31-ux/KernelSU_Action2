# Identical to config/gta9_nopatch.env except that NO_TREE_PATCHES is replaced by
# PATCH_WHITELIST. Both files are copies of the same base, and this one is a copy
# of the other rather than a fresh transcription, which is how the KCFLAGS key
# stayed wrong for a run once.
#
# Only the four patches that delete per-SoC objects from Makefiles run:
# 1 camera pda, 3 cmdq mailbox, 4 mdp, 29 gpufreq. A test over the wrapped
# bodies confirms none of the four touches a .c file, while fifteen of the other
# twenty-five do.
#
# The reasoning is the failure itself. The kernel that linked clean died before
# userspace with no panic, no pstore record and no adbd, so nothing on the device
# could say where. A kernel that fails to link tells you loudly which two symbols
# collided. A kernel that boots and then dies quietly usually has a rewritten
# source file, so the .c edits are the likelier cause and are the ones held back.
#
#   boots        -> the twenty-one .c patches are the cause, and every one of
#                   them comes straight back
#   fails to link-> these four are load-bearing; put them back and add the rest
#   neither     -> the cause is here after all, which is worth knowing because
#                   these are the four least invasive edits in the file
KERNEL_SOURCE=https://github.com/vickcoy31-ux/kernelvalidevo
KERNEL_SOURCE_BRANCH=14.0
KERNEL_CONFIG=/config/gta9_stock_defconfig
KERNEL_NAME=gta9

# The tablet's own `uname -a`. This is the part that has to match for the
# stock modules in /vendor_dlkm to load, so it stays pinned here too.
KERNEL_LOCALVERSION=-android12-9-28698995

PATCH_WHITELIST=1,3,4,29

KSU_VARIANT=resukisu
KSU_HOOK_MODE=tracepoint
ENABLE_SUSFS=false
ENABLE_PATH_UMOUNT=false
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

USE_CUSTOM_CLANG=true
CUSTOM_CLANG_SOURCE=https://github.com/ZyCromerZ/Clang/releases/download/16.0.6-20260807-release/Clang-16.0.6-20260807.tar.gz
USE_LLVM=true
ENABLE_GCC_ARM64=false
ENABLE_GCC_ARM32=false

DISABLE_CC_WERROR=true
DISABLE_LTO=false
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=false
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
NEED_DTBO=false
KERNEL_IMAGE_NAME=Image.gz
KCFLAGS=-Wno-error -Wno-error=deprecated-non-prototype -Wno-error=unused-but-set-variable -Wno-error=unused-function -Wno-error=implicit-int -Wno-error=frame-larger-than -Wno-error=comment -Wno-error=implicit-function-declaration -Wno-error=incompatible-pointer-types -Wno-error=unused-result -Wno-error=declaration-after-statement

# No Odin image from this run. It would have to go through a .tar to be flashed
# anyway, and the last one was assembled by hand and tested; the workflow's
# repack writes 4 bytes of AVB footer that Odin then rejects. The kernel image
# is the deliverable, and the boot image is made on the machine that has the
# stock image.
BUILD_BOOT_IMG=false
BUILD_ODIN_BOOT_IMG=false
SOURCE_BOOT_IMAGE=boot/boot.img
USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=
EXTRA_CMDS=
CUSTOM_CMDS=

# Only the twenty-four MT6983 options, which name a different chipset and do
# not compile against this branch's sound driver and clock tree. Everything
# else stays as the device has it. TRIM_UNUSED_KSYMS is off because its
# whitelist was never published; the stock config has it on, and leaving it off
# only means this kernel exports more symbols than the tablet's modules need.
# CONFIG_MTK_COMBO, the WiFi and Bluetooth combo chip, is never pinned.
EXTRA_DEFCONFIG=CONFIG_TRIM_UNUSED_KSYMS=n CONFIG_SND_SOC_MT6983=n CONFIG_SND_SOC_MT6983_MT6338=n CONFIG_COMMON_CLK_MT6983=n CONFIG_COMMON_CLK_MT6983_ADSP=n CONFIG_COMMON_CLK_MT6983_CAM=n CONFIG_COMMON_CLK_MT6983_CCU=n CONFIG_COMMON_CLK_MT6983_IMG=n CONFIG_COMMON_CLK_MT6983_MMSYS=n CONFIG_COMMON_CLK_MT6983_IMP_IIC_WRAP=n CONFIG_COMMON_CLK_MT6983_MDPSYS=n CONFIG_COMMON_CLK_MT6983_MFG=n CONFIG_COMMON_CLK_MT6983_VCODEC=n CONFIG_DEVAPC_MT6983=n CONFIG_MTK_SLBC_MT6983=n CONFIG_MTK_CM_MGR_MT6983=n CONFIG_MTK_DCM_MT6983=n CONFIG_MTK_LPM_MT6983=n CONFIG_MTK_SWPM_MT6983=n CONFIG_MTK_MDP_MT6983=n CONFIG_TOUCHSCREEN_MT6983_ALPHA_SUPPORT=n CONFIG_PINCTRL_MT6983=n CONFIG_GAUGE_MT6983_ALPHA_SUPPORT=n CONFIG_REGULATOR_MT6983_ALPHA_SUPPORT=n CONFIG_MTK_GPU_MT6983_SUPPORT=n
